+    // ------------------------------------------------------------------
+    bool nullspaceElbowJointPush(Eigen::VectorXf& q_push, float envelope) const {
+        if (!sdf_built_ || cylinders_.empty() || envelope <= 0.0f) return false;
+
+        // 肘部球:panda_link4 的第一个球(z=0.05,肘关节处)
+        const RobotSphere* elbow = nullptr;
+        for (const auto& rs : spheres_)
+            if (rs.link_name == "panda_link4") { elbow = &rs; break; }
+        if (!elbow) return false;
+
+        Eigen::Matrix4f pose = robot_->getFramePoseById(elbow->frame_id);
+        Eigen::Vector3f p = pose.block<3,1>(0,3)
+                          + pose.block<3,3>(0,0) * elbow->offset;
+        if (sampleSdf(p) - elbow->radius > envelope) return false;  // 早退
+
+        // 张量 + 最深枝条的径向逃逸方向(用于定符号)
+        Eigen::Matrix3f M = Eigen::Matrix3f::Zero();
+        Eigen::Vector3f r_out = Eigen::Vector3f::Zero();
+        float w_max = 0.0f;
+        bool  any = false;
+        for (const auto& cyl : cylinders_) {
+            if (cyl.exclude_from_aniso) continue;
+            if (cyl.axis_unit.squaredNorm() < 0.25f) continue;
+            float d = distToCylinder(p, cyl) - elbow->radius;
+            if (d >= envelope) continue;
+            float W = 1.0f - d / envelope;   // UNCLAMPED,同 tensor 约定
+            M.noalias() += W * (cyl.axis_unit * cyl.axis_unit.transpose());
+            any = true;
+            if (W > w_max) {
+                w_max = W;
+                const Eigen::Vector3f v = cyl.p1 - cyl.p0;
+                float vsq = v.squaredNorm();
+                float t = (vsq > 1e-6f)
+                          ? std::max(0.0f, std::min(1.0f, (p - cyl.p0).dot(v) / vsq))
+                          : 0.0f;
+                Eigen::Vector3f r = p - (cyl.p0 + t * v);
+                float rn = r.norm();
+                if (rn > 1e-6f) r_out = r / rn;
+            }
+        }
+        if (!any) return false;
+
+        Eigen::SelfAdjointEigenSolver<Eigen::Matrix3f> es(M);
+        if (es.info() != Eigen::Success) return false;
+        Eigen::Vector3f u = es.eigenvectors().col(0);   // 最小特征向量(升序)
+        if (r_out.squaredNorm() > 1e-6f && u.dot(r_out) < 0.0f) u = -u;
+
+        // 关节空间推力方向:q_push = J_eᵀ u(梯度方向;幅值由调用方定)
+        grasp_rrt::MatrixXf Je;
+        auto panda = dynamic_cast<PandaPinocchioRobot*>(robot_.get());
+        if (panda) {
