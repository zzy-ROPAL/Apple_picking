+        } else {
+            robot_->prepareJacobians();
+            Je = robot_->computeSphereJacobianById(elbow->frame_id, elbow->offset);
+        }
+        q_push = Je.transpose() * u;
+        return q_push.norm() > 1e-8f;
+    }
